    <!-- مختبر العلوم - الحيوانات (اسم + حقيقة سريعة + ٣ حقائق لكل حيوان) -->
    <string name="sl_animal_lion_name">Lion</string>
    <string name="sl_animal_lion_quick">The only cat that lives in groups (prides).</string>
    <string name="sl_animal_lion_fact1">The lion is called the \"king of the jungle\" even though it mostly lives in grasslands.</string>
    <string name="sl_animal_lion_fact2">A lion\'s roar can be heard from up to 8 kilometers away.</string>
    <string name="sl_animal_lion_fact3">Lionesses do most of the hunting, not the males.</string>
    <string name="sl_animal_elephant_name">Elephant</string>
    <string name="sl_animal_elephant_quick">The largest land animal in the world.</string>
    <string name="sl_animal_elephant_fact1">An elephant\'s trunk has more than 40,000 muscles.</string>
    <string name="sl_animal_elephant_fact2">Elephants remember things for years - their memory is very strong.</string>
    <string name="sl_animal_elephant_fact3">Elephants communicate with very low sounds humans can\'t hear.</string>
    <string name="sl_animal_cat_name">Cat</string>
    <string name="sl_animal_cat_quick">Cats sleep most of their lives - about 13-16 hours a day.</string>
    <string name="sl_animal_cat_fact1">Cats can rotate their ears 180 degrees.</string>
    <string name="sl_animal_cat_fact2">Every cat has a unique nose print, like a human fingerprint.</string>
    <string name="sl_animal_cat_fact3">Cats can\'t taste sweetness.</string>
    <string name="sl_animal_dog_name">Dog</string>
    <string name="sl_animal_dog_quick">Dogs are among the oldest domesticated animals to accompany humans.</string>
    <string name="sl_animal_dog_fact1">A dog\'s sense of smell is thousands of times stronger than a human\'s.</string>
    <string name="sl_animal_dog_fact2">A dog\'s nose print is unique, like a human fingerprint.</string>
    <string name="sl_animal_dog_fact3">Dogs only sweat through their paw pads, and pant to cool their body down.</string>
    <string name="sl_animal_whale_name">Whale</string>
    <string name="sl_animal_whale_quick">The blue whale is the largest animal ever to have lived on Earth.</string>
    <string name="sl_animal_whale_fact1">A blue whale\'s heart is roughly the size of a small car.</string>
    <string name="sl_animal_whale_fact2">Whales breathe air just like humans (mammals).</string>
    <string name="sl_animal_whale_fact3">Some whales migrate thousands of kilometers every year.</string>
    <string name="sl_animal_crocodile_name">Crocodile</string>
    <string name="sl_animal_crocodile_quick">Crocodiles are among the oldest reptiles, barely changed since the age of dinosaurs.</string>
    <string name="sl_animal_crocodile_fact1">A crocodile\'s bite force is one of the strongest in the animal kingdom.</string>
    <string name="sl_animal_crocodile_fact2">Crocodiles can live more than 70 years.</string>
    <string name="sl_animal_crocodile_fact3">Crocodiles are cold-blooded, relying on the sun to regulate their temperature.</string>
    <string name="sl_animal_turtle_name">Turtle</string>
    <string name="sl_animal_turtle_quick">Some turtle species live more than 100 years.</string>
    <string name="sl_animal_turtle_fact1">A turtle\'s shell is part of its skeleton - it can\'t take it off.</string>
    <string name="sl_animal_turtle_fact2">Sea turtles travel thousands of kilometers to lay eggs on the same beach where they were born.</string>
    <string name="sl_animal_turtle_fact3">Turtles are reptiles and breathe air even though some live in water.</string>
    <string name="sl_animal_snake_name">Snake</string>
    <string name="sl_animal_snake_quick">Snakes smell scents with their forked tongue.</string>
    <string name="sl_animal_snake_fact1">Snakes have no eyelids - their eyes are covered by a fixed transparent layer.</string>
    <string name="sl_animal_snake_fact2">Some snakes shed their skin several times a year to grow.</string>
    <string name="sl_animal_snake_fact3">Not all snakes are venomous - most are completely harmless.</string>
    <string name="sl_animal_frog_name">Frog</string>
    <string name="sl_animal_frog_quick">Frogs breathe through their skin in addition to their lungs.</string>
    <string name="sl_animal_frog_fact1">A frog starts life as a tadpole (larva) that lives only in water.</string>
    <string name="sl_animal_frog_fact2">A frog\'s skin must stay moist for it to breathe properly.</string>
    <string name="sl_animal_frog_fact3">Some frogs are extremely venomous despite their small size.</string>
    <string name="sl_animal_salamander_name">Salamander</string>
    <string name="sl_animal_salamander_quick">A salamander can regrow its tail or limbs if they are lost.</string>
    <string name="sl_animal_salamander_fact1">Salamanders are amphibians like frogs - part of their life is in water, part on land.</string>
    <string name="sl_animal_salamander_fact2">A salamander\'s skin is moist and needs a humid environment to survive.</string>
    <string name="sl_animal_salamander_fact3">Some salamander species breathe only through their skin, with no lungs.</string>
    <string name="sl_animal_eagle_name">Eagle</string>
    <string name="sl_animal_eagle_quick">An eagle\'s eyesight is many times stronger than a human\'s.</string>
    <string name="sl_animal_eagle_fact1">An eagle can spot prey from about a kilometer up.</string>
    <string name="sl_animal_eagle_fact2">An eagle\'s talons are very strong and used for hunting.</string>
    <string name="sl_animal_eagle_fact3">Some eagles build the same nest and reuse it for years.</string>
    <string name="sl_animal_penguin_name">Penguin</string>
    <string name="sl_animal_penguin_quick">A penguin is a bird that can\'t fly, but is an excellent swimmer.</string>
    <string name="sl_animal_penguin_fact1">A penguin\'s feathers are dense and waterproof, protecting it from the cold.</string>
    <string name="sl_animal_penguin_fact2">Some penguin species live in extremely cold regions like Antarctica.</string>
    <string name="sl_animal_penguin_fact3">Penguins can dive to great depths searching for food.</string>
    <string name="sl_animal_parrot_name">Parrot</string>
    <string name="sl_animal_parrot_quick">Parrots are among the smartest birds and can mimic sounds.</string>
    <string name="sl_animal_parrot_fact1">Some parrots live more than 60 years.</string>
    <string name="sl_animal_parrot_fact2">Parrots use their beak and claws together to climb.</string>
    <string name="sl_animal_parrot_fact3">A parrot\'s vivid feather colors help them recognize each other.</string>
    <string name="sl_animal_shark_name">Shark</string>
    <string name="sl_animal_shark_quick">Sharks have existed on Earth for millions of years before dinosaurs.</string>
    <string name="sl_animal_shark_fact1">A shark\'s teeth constantly regrow throughout its life.</string>
    <string name="sl_animal_shark_fact2">A shark\'s sense of smell is very strong - it can smell blood at extremely low concentrations in water.</string>
    <string name="sl_animal_shark_fact3">Most shark species pose no danger to humans at all.</string>
    <string name="sl_animal_goldfish_name">Goldfish</string>
    <string name="sl_animal_goldfish_quick">A goldfish\'s memory is much longer than the common belief (just seconds).</string>
    <string name="sl_animal_goldfish_fact1">A goldfish can remember things for months.</string>
    <string name="sl_animal_goldfish_fact2">It breathes through gills that extract oxygen from water.</string>
    <string name="sl_animal_goldfish_fact3">The size of its tank significantly affects how large it grows.</string>

