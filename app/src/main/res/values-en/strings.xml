    <string name="sl_part_heart_desc">A muscular organ that pumps blood to every part of the body, supplying it with oxygen and nutrients.</string>
    <string name="sl_part_lungs_name">The Lungs</string>
    <string name="sl_part_lungs_desc">Responsible for breathing - they take in oxygen from the air and expel carbon dioxide.</string>
    <string name="sl_part_brain_name">The Brain</string>
    <string name="sl_part_brain_desc">The body\'s entire control center - it controls thinking, movement, and the senses.</string>
    <string name="sl_part_stomach_name">The Stomach</string>
    <string name="sl_part_stomach_desc">An organ that digests food using strong acids and digestive juices.</string>
    <string name="sl_part_kidneys_name">The Kidneys</string>
    <string name="sl_part_kidneys_desc">Filter the blood of waste and regulate the body\'s water level through urine.</string>
    <string name="sl_part_skin_name">The Skin</string>
    <string name="sl_part_skin_desc">The body\'s largest organ - protects against germs and regulates temperature.</string>
    <string name="sl_part_liver_name">The Liver</string>
    <string name="sl_part_liver_desc">The body\'s largest gland - filters toxins from the blood and stores energy.</string>
    <string name="sl_part_intestines_name">The Intestines</string>
    <string name="sl_part_intestines_desc">A long tube that finishes digesting food and absorbs useful nutrients into the blood.</string>

